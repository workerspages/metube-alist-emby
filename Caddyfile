# Caddy 反向代理配置
# 统一端口 :8080，通过路径分发到各服务
# 如需开启 HTTPS，将 :8080 替换为实际域名，如： your.domain.com
#
# MeTube / 诊断面板 Basic Auth 说明：
#   用户名固定为 admin
#   密码通过环境变量配置：
#     METUBE_AUTH_HASH   - MeTube 的 bcrypt 密码哈希
#     DEBUG_AUTH_HASH    - 诊断面板的 bcrypt 密码哈希
#   生成哈希命令：caddy hash-password --plaintext '你的密码'

:8080 {
    # 全局安全响应头
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # 门户首页
    handle / {
        root * /srv/portal
        file_server
    }

    # Emby Web UI (Emby 默认将 UI 放在 /web/ 路径)
    handle /web/* {
        reverse_proxy localhost:8096
    }

    # Emby API (Emby 默认将 API 放在 /emby/ 路径)
    handle /emby/* {
        reverse_proxy localhost:8096
    }

    # Emby WebSocket
    handle /embywebsocket {
        reverse_proxy localhost:8096
    }

    # MeTube - Basic Auth 保护
    # 需设置环境变量 METUBE_AUTH_HASH（bcrypt 哈希）
    handle /metube/* {
        basic_auth {
            admin {env.METUBE_AUTH_HASH}
        }
        reverse_proxy localhost:8081
    }

    # Alist - 不剥离前缀，Alist 通过 site_url 处理
    handle /alist/* {
        reverse_proxy localhost:5244
    }

    # STRM Sync 诊断面板 - Basic Auth 保护
    # 需设置环境变量 DEBUG_AUTH_HASH（bcrypt 哈希）
    handle /debug/* {
        basic_auth {
            admin {env.DEBUG_AUTH_HASH}
        }
        uri strip_prefix /debug
        reverse_proxy localhost:9090
    }

    # qBittorrent Web UI
    handle /qbittorrent/* {
        uri strip_prefix /qbittorrent
        reverse_proxy localhost:8082 {
            header_up Host {host}
            header_up X-Forwarded-Host {host}
        }
    }

    # MetaTube Server API
    handle /metatube-server/* {
        uri strip_prefix /metatube-server
        reverse_proxy localhost:8083
    }

    # rclone WebDAV
    # rclone serve 使用 --baseurl /rclone，无需 strip_prefix
    # 显式透传 Authorization 头，确保 Basic Auth 认证生效
    handle /rclone* {
        reverse_proxy localhost:8085 {
            header_up Authorization {http.request.header.Authorization}
        }
    }
}
