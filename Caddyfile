# Caddy 反向代理配置
# 统一端口 :8080，通过路径分发到各服务

:8080 {
    # 门户首页
    handle / {
        root * /srv/portal
        file_server
    }

    # Emby Web UI (Emby 默认将 UI 放在 /web/ 路径)
    handle /web/* {
        reverse_proxy localhost:8096
    }

    # Emby API (Emby 默认将 API 放在 /emby/ 路径)
    handle /emby/* {
        reverse_proxy localhost:8096
    }

    # Emby WebSocket
    handle /embywebsocket {
        reverse_proxy localhost:8096
    }

    # MeTube - 不剥离前缀，MeTube 通过 URL_PREFIX 处理
    handle /metube/* {
        reverse_proxy localhost:8081
    }

    # Alist - 不剥离前缀，Alist 通过 site_url 处理
    handle /alist/* {
        reverse_proxy localhost:5244
    }

    # STRM Sync 诊断面板
    handle /debug/* {
        uri strip_prefix /debug
        reverse_proxy localhost:9090
    }
}
